# Twitch application (https://dev.twitch.tv/console/apps)
# OAuth Redirect URL must be exactly: http://localhost:3000/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Your channel login name (lowercase)
TWITCH_CHANNEL=

# Local server
PORT=
# Chat command prefix (default "!")
BOT_PREFIX=

# Lily (AI co-host) - Claude API key; leave empty for canned lines only
ANTHROPIC_API_KEY=
LILY_MODEL=
# auto | edge | sapi | off
LILY_TTS=
LILY_VOICE=
# Minutes between idle lines (0 = off)
LILY_IDLE_MINUTES=
